# Absolute path to tg-bot's existing mutes.db (read-only)
GAME_DB_PATH=/root/Try_bot/mutes.db
# tg-bot's own bot token, needed to verify Telegram Mini App initData
# signatures. Must be BYTE-IDENTICAL to tg-bot's own BOT_TOKEN env var —
# Telegram signs initData with whichever bot's token the Mini App was
# opened through, so a mismatch here doesn't error or crash anything, it
# just makes every single login silently fail (verifyWebAppInitData
# always returns null, /tma/auth always 403s). There is no runtime check
# for this — verify by comparing the two values directly at deploy time.
TG_BOT_TOKEN=
# Comma-separated numeric Telegram user_ids allowed into /admin
ADMIN_USER_IDS=123456789
# Random long string used to sign the session cookie
SESSION_SECRET=
# Port this app listens on
PORT=3000
# Set to "production" on the real deploy — marks the session cookie Secure
# (HTTPS-only). Leave unset for local http:// dev testing.
NODE_ENV=
